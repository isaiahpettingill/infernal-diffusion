[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.6"
reloadable = false

[libraries]
windows.x86_64 = "./bin/infernal_godot.windows.x86_64.dll"
windows.x86_32 = "./bin/infernal_godot.windows.x86_32.dll"
windows.arm64 = "./bin/infernal_godot.windows.arm64.dll"
linux.x86_64 = "./bin/libinfernal_godot.linux.x86_64.so"
linux.x86_32 = "./bin/libinfernal_godot.linux.x86_32.so"
linux.arm64 = "./bin/libinfernal_godot.linux.arm64.so"
macos.x86_64 = "./bin/libinfernal_godot.macos.x86_64.dylib"
macos.arm64 = "./bin/libinfernal_godot.macos.arm64.dylib"

[dependencies]
windows.x86_64 = { "./bin/infernal_diffusion_x64.dll": "" }
windows.x86_32 = { "./bin/infernal_diffusion_x86.dll": "" }
windows.arm64 = { "./bin/infernal_diffusion_arm64.dll": "" }
linux.x86_64 = { "./bin/libinfernal_diffusion_x64.so": "" }
linux.x86_32 = { "./bin/libinfernal_diffusion_x86.so": "" }
linux.arm64 = { "./bin/libinfernal_diffusion_arm64.so": "" }
macos.x86_64 = { "./bin/libinfernal_diffusion_x64.dylib": "Contents/Frameworks" }
macos.arm64 = { "./bin/libinfernal_diffusion_arm64.dylib": "Contents/Frameworks" }
